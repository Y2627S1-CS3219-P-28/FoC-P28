# AI Assistance Disclosure:
# Tool: OpenAI Codex (GPT-5), date: 2026-10-13
# Mode: Implementation and configuration.
# Scope: Updated the environment contract for the team-specified Reporting Service and private attachment storage.
# Author review: I reviewed for correctness.
#
# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# docker compose reads this file automatically. Cloud environments
# are configured in infra/environments/<env>.env and <service>/deploy/.
# ─────────────────────────────────────────────────────────────

# ---- Compose host ports ---------------------------------------
GATEWAY_PORT=8080
FRONTEND_PORT=3000
ORDER_SERVICE_PORT=8083
ORDER_POSTGRES_PORT=5433
CREDIT_POSTGRES_PORT=5434
REPORTING_SERVICE_PORT=8086

# ---- Global (all backend services) ----------------------------
LOG_LEVEL=INFO
# Set to `ecs` in the cloud for structured JSON logs (Spring Boot).
LOGGING_STRUCTURED_FORMAT_CONSOLE=

# ---- Firestore services (each owns one database) --------------
FIRESTORE_PROJECT_ID=demo-foc
# Per service: <name>-<environment>, e.g. supplier-local, supplier-staging
FIRESTORE_DATABASE_ID=
# Set only when using the emulator (compose sets it for you)
FIRESTORE_EMULATOR_HOST=localhost:8090

# ---- Reporting Service private attachments -------------------
STORAGE_PROJECT_ID=demo-foc
STORAGE_EMULATOR_HOST=http://localhost:9199
REPORTING_STORAGE_BUCKET=demo-foc-reporting-local
ORDER_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_TIMEOUT=5s

# ---- Report resolution saga (enable only after both services/topics are ready) ----
REPORT_RESOLUTION_ENABLED=false
REPORT_PUBSUB_PROJECT_ID=demo-foc
REPORT_RESOLUTION_RESULT_TOPIC=
# Full projects/<project>/subscriptions/<subscription> path, not just the ID.
REPORT_RESOLUTION_COMPENSATION_SUBSCRIPTION=
REPORT_RESOLUTION_PUSH_MODE=google
REPORT_RESOLUTION_PUSH_AUDIENCE=
REPORT_RESOLUTION_PUSH_SERVICE_ACCOUNT=
REPORT_RESULT_RECOVERY_CRON=0 * * * * *
REPORT_RESPONSE_RECOVERY_CRON=0 * * * * *

# ---- Local Credit Service PostgreSQL --------------------------
# Used by Docker Compose. Cloud SQL credentials are configured separately.
CREDIT_DB_NAME=credit_service
CREDIT_DB_USERNAME=credit_dev
CREDIT_DB_PASSWORD=credit_dev_password
# Direct source-run equivalents (Compose maps the CREDIT_DB_* values above).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/credit_service
SPRING_DATASOURCE_USERNAME=credit_dev
SPRING_DATASOURCE_PASSWORD=credit_dev_password
SPRING_FLYWAY_ENABLED=true

# ---- Auth (Firebase ID tokens) --------------------------------
FIREBASE_AUTH_PROJECT_ID=demo-foc
# Set only when using the emulator (compose sets it for you)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ---- User Service integration ---------------------------------
# mock = roles faked from MOCK_ADMIN_EMAILS; http = GET USER_SERVICE_URL/api/users/role-context with the caller's token
USER_SERVICE_MODE=mock
# Order Service prod profile uses HTTP roles independently of this shared mock mode.
# Pass this override to Order Service only; local !prod remains anonymous.
ORDER_USER_SERVICE_MODE=http
USER_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8083
# Comma-separated emails that get the admin role in mock mode
MOCK_ADMIN_EMAILS=admin@u.nus.edu,e1398851@u.nus.edu

# ---- Local Order Service PostgreSQL ---------------------------
# Used only by docker compose. Cloud SQL credentials are configured separately.
ORDER_DB_NAME=order_service
ORDER_DB_USERNAME=order_dev
ORDER_DB_PASSWORD=order_dev_password
ORDER_LIFECYCLE_TOKEN=local-lifecycle
ORDER_LIFECYCLE_EXTERNAL_ENABLED=false
# Spring cron: second, minute, hour, day, month, weekday.
# One shared job: command recovery, OPEN expiry, >=48-hour DELIVERED completion.
ORDER_LIFECYCLE_CRON=0 * * * * *
ORDER_COMMANDS_ENABLED=true
ORDER_COMMAND_LEASE_SECONDS=120
# retry is the existing default. compensate requires the explicitly enabled,
# validated transport below for HTTP peers; cloud activation is a coordinated rollout.
ORDER_COMMAND_RECOVERY_POLICY=retry
# Opt-in compensation transport; keep disabled until coordinated verification/rollout.
ORDER_COMPENSATION_ENABLED=false
ORDER_COMPENSATION_REQUEST_TOPIC=
ORDER_COMPENSATION_RESULT_SUBSCRIPTION=
ORDER_COMPENSATION_PUSH_MODE=google
ORDER_COMPENSATION_PUSH_AUDIENCE=
ORDER_COMPENSATION_PUSH_SERVICE_ACCOUNT=
ORDER_COMMAND_RESOLUTION_SECONDS=120
ORDER_COMMAND_RETRY_SECONDS=15
ORDER_COMMAND_BATCH_SIZE=20
ORDER_PEER_CONNECT_TIMEOUT=3s
ORDER_PEER_READ_TIMEOUT=5s
# Recovery only; new events are still published immediately after commit.
ORDER_OUTBOX_RECOVERY_CRON=0 */15 * * * *

# ---- Order Service local Pub/Sub emulator ---------------------
# Local Admin UI prototype only. Cloud defaults false; requires FOC_ENVIRONMENT=local
# and FIREBASE_AUTH_EMULATOR_HOST too. No real role, account or supplier changes.
ORDER_ADMIN_MOCK_ENABLED=true
# Compose pins these values and ignores old cloud/ADC values in a private .env.
# Cloud deployments use infra/environments/<env>.env + order-service/deploy/env.yaml.
ORDER_MESSAGING_MODE=emulator
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
PUBSUB_PROJECT_ID=demo-foc-local
ORDER_COMPLETION_TOPIC=order-completion-local-v1
ORDER_OPEN_REFUND_TOPIC=open-order-refund-local-v1
ORDER_COURIER_PENALTY_ADDITION_TOPIC=courier-penalty-addition-local-v1
ORDER_COURIER_PENALTY_DEDUCTION_TOPIC=courier-penalty-deduction-local-v1
ORDER_CREDIT_COMPENSATION_TOPIC=credit-command-compensation-local-v1
USER_CREATED_TOPIC=user-created-local-v1

# ---- Credit Service Order/User-event push subscriptions -------
CREDIT_PUBSUB_PUSH_AUDIENCE=http://localhost:8084
CREDIT_PUBSUB_PUSH_SERVICE_ACCOUNT=foc-credit-push-local@demo-foc.iam.gserviceaccount.com
CREDIT_PUBSUB_PUSH_MODE=emulator
CREDIT_ORDER_COMPLETION_SUBSCRIPTION=credit-order-completion-local-v1
CREDIT_ORDER_OPEN_REFUND_SUBSCRIPTION=credit-open-order-refund-local-v1
CREDIT_COMPENSATION_SUBSCRIPTION=credit-command-compensation-local-v1
CREDIT_COMPENSATION_RESULT_TOPIC=credit-command-compensation-result-local-v1
CREDIT_MESSAGING_MODE=emulator
CREDIT_PUBLISH_TIMEOUT=10s
CREDIT_RESULT_OUTBOX_BATCH_SIZE=50
CREDIT_RESULT_OUTBOX_RECOVERY_CRON=0 * * * * *
CREDIT_USER_CREATED_SUBSCRIPTION=credit-user-created-local-v1
# No gcloud, GOOGLE_APPLICATION_CREDENTIALS_HOST or LOCAL_TEST_ID is needed.
# Steps/commands: order-service/docs/local-live-testing.md

# ---- CORS -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Supplier Service -----------------------------------------
# CSV loaded at startup (mounted, not baked into the image)
SUPPLIER_SEED_FILE=../data/csv/supplier-seed-data.csv
# Max 60s (NFR5.3.2)
SUPPLIER_CACHE_TTL=60s
# Compose only: roles from the User Service (http) or from MOCK_ADMIN_EMAILS (mock)
SUPPLIER_USER_SERVICE_MODE=http
# Role lookups: connect/read timeout (cover a cold start in the cloud) and per-user cache (0s disables)
USER_SERVICE_TIMEOUT=3s
USER_SERVICE_ROLE_CACHE_TTL=30s

# ---- User Service -----------------------------------------
# Local MongoDB is provided by Docker Compose.
# MONGODB_URI=

# ---- Frontend (read at request time, not build time) ----------
FOC_ENVIRONMENT=local
# Admin UI source-run mode: mock or live. Mock is allowed only locally with Auth emulator.
# Base Compose pins mock; compose.http-peers.yaml pins live. Cloud always uses live.
FOC_ADMIN_API_MODE=mock
FOC_API_BASE_URL=http://localhost:8080
# Cloud only: direct visits to the frontend's own URL redirect here (the gateway). Leave empty locally.
FOC_PUBLIC_URL=
FOC_FIREBASE_PROJECT_ID=demo-foc
FOC_FIREBASE_API_KEY=demo-api-key
FOC_FIREBASE_AUTH_DOMAIN=
FOC_FIREBASE_APP_ID=
FOC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
FOC_INTERNAL_ORDER_API_ENABLED=false
ORDER_AUTO_REPOST_ENABLED=false
