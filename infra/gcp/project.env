# Shared, non-secret GCP settings used by infra/gcp/bootstrap.sh, scripts/ci/*.sh and the
# GitHub Actions workflows. Plain KEY=value lines only (also loaded into $GITHUB_ENV).
PROJECT_ID=protean-vigil-509704-q4
PROJECT_NUMBER=374055363871
REGION=asia-southeast1
AR_REPO=foc
GITHUB_REPO=Y2627S1-CS3219-P-28/FoC-P28
WIF_PROVIDER=projects/374055363871/locations/global/workloadIdentityPools/github/providers/github-actions
DEPLOYER_SA=foc-deployer@protean-vigil-509704-q4.iam.gserviceaccount.com

# Order Service approved Cloud SQL configuration (ADR-008). These are non-secret
# provisioning/deployment settings; database passwords live in Secret Manager.
CLOUD_SQL_INSTANCE=order-postgres
# PostgreSQL 15 keeps the approved low-cost shared-core tier on the Enterprise edition;
# upgrade deliberately after compatibility and cost review.
CLOUD_SQL_DATABASE_VERSION=POSTGRES_15
CLOUD_SQL_TIER=db-f1-micro
CLOUD_SQL_STORAGE_TYPE=SSD
CLOUD_SQL_STORAGE_SIZE_GB=10
CLOUD_SQL_BACKUP_START_TIME=03:00
CLOUD_SQL_STAGING_DATABASE=order_staging
CLOUD_SQL_PRODUCTION_DATABASE=order_production
CLOUD_SQL_STAGING_USER=order_staging_app
CLOUD_SQL_PRODUCTION_USER=order_production_app
CLOUD_SQL_STAGING_SECRET=order-db-staging-password
CLOUD_SQL_PRODUCTION_SECRET=order-db-production-password

# Credit Service databases on the shared instance. Each environment has an isolated
# database, runtime user, and Secret Manager password.
CREDIT_SQL_STAGING_DATABASE=credit_staging
CREDIT_SQL_PRODUCTION_DATABASE=credit_production
CREDIT_SQL_STAGING_USER=credit_staging_app
CREDIT_SQL_PRODUCTION_USER=credit_production_app
CREDIT_SQL_STAGING_SECRET=credit-db-staging-password
CREDIT_SQL_PRODUCTION_SECRET=credit-db-production-password

# User Service MongoDB Atlas connection string per environment (Secret Manager). bootstrap.sh creates the
# secrets and grants access; the owner adds the value:
#   printf '%s' "$URI" | gcloud secrets versions add <secret> --data-file=-
USER_MONGODB_STAGING_SECRET=user-mongodb-uri-staging
USER_MONGODB_PRODUCTION_SECRET=user-mongodb-uri-production

# Credit Service authenticated Pub/Sub push delivery. Staging is active first;
# flip production to true in the production-promotion change before provisioning it.
CREDIT_PUBSUB_STAGING_ENABLED=true
CREDIT_PUBSUB_PRODUCTION_ENABLED=false
CREDIT_PUBSUB_STAGING_DLQ_TOPIC=credit-order-events-dead-letter-staging-v1
CREDIT_PUBSUB_PRODUCTION_DLQ_TOPIC=credit-order-events-dead-letter-prod-v1
CREDIT_PUBSUB_STAGING_DLQ_SUBSCRIPTION=credit-order-events-dead-letter-staging-v1-recovery
CREDIT_PUBSUB_PRODUCTION_DLQ_SUBSCRIPTION=credit-order-events-dead-letter-prod-v1-recovery
