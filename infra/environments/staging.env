# Non-secret configuration for the staging environment, sourced by scripts/ci/deploy.sh and
# substituted into each <service>/deploy/env.yaml. Secrets belong in Secret Manager.
ENVIRONMENT=staging

# Firestore lives in the GCP project; each service uses database <name>-staging.
FIRESTORE_PROJECT_ID=protean-vigil-509704-q4

# Firebase Auth project that issues user ID tokens (the team's shared auth project).
# The web API key is a public identifier, not a secret.
FIREBASE_AUTH_PROJECT_ID=cs3219-p28-auth
FIREBASE_AUTH_DOMAIN=cs3219-p28-auth.firebaseapp.com
FIREBASE_WEB_API_KEY=AIzaSyBEGMjbEkDoFj3K_uerljvTpQg0i8ELCPE
FIREBASE_APP_ID=1:13819128878:web:fd3ea6c22c69e213f703bf

# User Service integration: "mock" fakes role lookups until the User Service API exists.
USER_SERVICE_MODE=mock
# Comma-separated emails granted the admin role while USER_SERVICE_MODE=mock.
MOCK_ADMIN_EMAILS=e1398851@u.nus.edu

LOG_LEVEL=INFO
ORDER_PEERS_MODE=http

# Order Service PostgreSQL on Cloud SQL (ADR-008); password is injected from Secret Manager.
ORDER_DB_INSTANCE_CONNECTION_NAME=protean-vigil-509704-q4:asia-southeast1:order-postgres
ORDER_DB_NAME=order_staging
ORDER_DB_USERNAME=order_staging_app
ORDER_DB_PASSWORD_SECRET=order-db-staging-password

# Order Service Pub/Sub topics (ADR-021). Staging has its own topics, so events published by local
# runs (the *-dev-v1 topics) never reach staging. Provisioned by infra/gcp/configure-order-pubsub.sh.
ORDER_ACCEPTED_CANCELLATION_TOPIC=accepted-order-cancellation-staging-v1
ORDER_OPEN_REFUND_TOPIC=open-order-refund-staging-v1
ORDER_COMPLETION_TOPIC=order-completion-staging-v1

# Order Service Spring scheduler intervals.
ORDER_LIFECYCLE_CRON="0 * * * * *"
ORDER_OUTBOX_RECOVERY_CRON="0 */15 * * * *"

# Credit Service PostgreSQL on the shared Cloud SQL instance.
CREDIT_DB_INSTANCE_CONNECTION_NAME=protean-vigil-509704-q4:asia-southeast1:order-postgres
CREDIT_DB_NAME=credit_staging
CREDIT_DB_USERNAME=credit_staging_app
CREDIT_DB_PASSWORD_SECRET=credit-db-staging-password

# Credit Order-event authenticated push subscriptions.
CREDIT_PUBSUB_PUSH_SERVICE_ACCOUNT=foc-credit-push-staging@protean-vigil-509704-q4.iam.gserviceaccount.com
CREDIT_ORDER_COMPLETION_SUBSCRIPTION=credit-order-completion-staging-v1
CREDIT_ORDER_OPEN_REFUND_SUBSCRIPTION=credit-open-order-refund-staging-v1
