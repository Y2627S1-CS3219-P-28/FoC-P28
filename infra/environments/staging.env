# Non-secret configuration for the staging environment, sourced by scripts/ci/deploy.sh and
# substituted into each <service>/deploy/env.yaml. Secrets belong in Secret Manager.
ENVIRONMENT=staging

# Firestore lives in the GCP project; each service uses database <name>-staging.
FIRESTORE_PROJECT_ID=protean-vigil-509704-q4

# Firebase Auth project that issues user ID tokens (the team's shared auth project).
# The web API key is a public identifier, not a secret.
FIREBASE_AUTH_PROJECT_ID=cs3219-p28-auth
FIREBASE_AUTH_DOMAIN=cs3219-p28-auth.firebaseapp.com
FIREBASE_WEB_API_KEY=AIzaSyBEGMjbEkDoFj3K_uerljvTpQg0i8ELCPE
FIREBASE_APP_ID=1:13819128878:web:fd3ea6c22c69e213f703bf

# Every service takes roles from the User Service (GET /api/users/role-context). "mock" makes everyone
# a requester and a courier and MOCK_ADMIN_EMAILS admins; it is kept only as a rollback switch.
USER_SERVICE_MODE=http
# Comma-separated emails granted the admin role, only while USER_SERVICE_MODE=mock.
MOCK_ADMIN_EMAILS=e1398851@u.nus.edu

LOG_LEVEL=INFO
ORDER_PEERS_MODE=http

# Order Service PostgreSQL on Cloud SQL (ADR-008); password is injected from Secret Manager.
ORDER_DB_INSTANCE_CONNECTION_NAME=protean-vigil-509704-q4:asia-southeast1:order-postgres
ORDER_DB_NAME=order_staging
ORDER_DB_USERNAME=order_staging_app
ORDER_DB_PASSWORD_SECRET=order-db-staging-password

# Order Service Pub/Sub topics (ADR-021). Staging has its own topics, so events published by local
# runs (the *-dev-v1 topics) never reach staging. Provisioned by infra/gcp/configure-order-pubsub.sh.
ORDER_OPEN_REFUND_TOPIC=open-order-refund-staging-v1
ORDER_COMPLETION_TOPIC=order-completion-staging-v1
ORDER_COURIER_PENALTY_ADDITION_TOPIC=courier-penalty-addition-dev-v1
ORDER_COURIER_PENALTY_DEDUCTION_TOPIC=courier-penalty-deduction-dev-v1
ORDER_CREDIT_COMPENSATION_TOPIC=credit-command-compensation-staging-v1
CREDIT_COMPENSATION_RESULT_TOPIC=credit-command-compensation-result-staging-v1
USER_CREATED_TOPIC=user-created-staging-v1

# Order Service Spring scheduler intervals.
ORDER_LIFECYCLE_CRON="0 * * * * *"
ORDER_OUTBOX_RECOVERY_CRON="0 */15 * * * *"

# User Service MongoDB Atlas connection string, injected from Secret Manager by user-service/deploy/service.conf.
USER_MONGODB_URI_SECRET=user-mongodb-uri-staging

# Credit Service PostgreSQL on the shared Cloud SQL instance.
CREDIT_DB_INSTANCE_CONNECTION_NAME=protean-vigil-509704-q4:asia-southeast1:order-postgres
CREDIT_DB_NAME=credit_staging
CREDIT_DB_USERNAME=credit_staging_app
CREDIT_DB_PASSWORD_SECRET=credit-db-staging-password

# Credit Order-event authenticated push subscriptions.
CREDIT_PUBSUB_PUSH_SERVICE_ACCOUNT=foc-credit-push-staging@protean-vigil-509704-q4.iam.gserviceaccount.com
CREDIT_ORDER_COMPLETION_SUBSCRIPTION=credit-order-completion-staging-v1
CREDIT_ORDER_OPEN_REFUND_SUBSCRIPTION=credit-open-order-refund-staging-v1
CREDIT_COMPENSATION_SUBSCRIPTION=credit-command-compensation-staging-v1
CREDIT_MESSAGING_MODE=google
ORDER_COMPENSATION_RESULT_SUBSCRIPTION=order-credit-compensation-result-staging-v1
ORDER_COMPENSATION_PUSH_SERVICE_ACCOUNT=foc-order-push-staging@protean-vigil-509704-q4.iam.gserviceaccount.com
CREDIT_PUBLISH_TIMEOUT=10s
CREDIT_RESULT_OUTBOX_BATCH_SIZE=50
CREDIT_RESULT_OUTBOX_RECOVERY_CRON="0 * * * * *"
CREDIT_USER_CREATED_SUBSCRIPTION=credit-user-created-staging-v1

# Report saga: prepare/wire with infra/gcp/configure-report-pubsub.sh before enabling.
# These dev topics are cloud staging ONLY; local Compose uses its emulator.
ORDER_REPORT_RESOLUTION_ENABLED=false
REPORT_RESOLUTION_ENABLED=false
ORDER_REPORT_RESOLUTION_TIMEOUT=5s
ORDER_REPORT_COMPENSATION_TOPIC=report-resolution-compensation-dev-v1
REPORT_COMPENSATION_RESULT_TOPIC=report-resolution-compensation-result-dev-v1
REPORT_RESOLUTION_REQUEST_SUBSCRIPTION=report-resolution-compensation-dev-v1-sub
ORDER_REPORT_COMPENSATION_RESULT_SUBSCRIPTION=report-resolution-compensation-result-dev-v1-sub
REPORT_RESOLUTION_PUSH_SERVICE_ACCOUNT=foc-report-push-staging@protean-vigil-509704-q4.iam.gserviceaccount.com
ORDER_REPORT_COMPENSATION_PUSH_SERVICE_ACCOUNT=foc-report-result-staging@protean-vigil-509704-q4.iam.gserviceaccount.com
